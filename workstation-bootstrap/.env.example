# Copy to .env and adjust. Never commit the real .env file.

# Absolute path to a local clone of the kv-backend repo. Used by
# scripts/kv-backend.sh and scripts/kv-clean-slate.sh to drive kv-backend's
# own docker-compose stack (kv-backend/preload-docker-compose) and Maven build.
KV_BACKEND_DIR=$HOME/workspace/repos/kv-backend

# ---------------------------------------------------------------------------
# Optional: Remote seed database (e.g. Uniserver shared dev MySQL)
# Used by: make kv-clean-slate-remote  (scripts/kv-clean-slate.sh --remote)
#
# When set, clean-slate pulls a data-only dump from this MySQL instance and
# imports it after Flyway builds the schema — giving every developer the same
# starting dataset as the shared dev DB.
#
# Leave all blank to use the bundled seed (mysql/db-init/02-kv_local.sql).
# ---------------------------------------------------------------------------
DEV_SEED_HOST=
DEV_SEED_PORT=3306
DEV_SEED_USER=
DEV_SEED_PASSWORD=
DEV_SEED_SCHEMA=kv
