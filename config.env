# =============================================================================
# config.env — Central Version Configuration
#
# SINGLE SOURCE OF TRUTH for all software versions used by this provisioner.
#
# Rules:
#   - Every version number lives here. Nowhere else.
#   - Shell scripts source this file:   source "$(dirname "$0")/../config.env"
#   - Ansible reads from:               ansible/group_vars/all/versions.yml
#     (keep both files in sync when bumping versions)
#
# To upgrade a tool: change the version here, then update the matching entry
# in ansible/group_vars/all/versions.yml.
# =============================================================================

# ---- Java (CRITICAL: only 8 and 17 — kv-backend compatibility) ------------
# These are Ubuntu apt package names, not SDKMAN identifiers.
JAVA_8_PKG="openjdk-8-jdk"
JAVA_17_PKG="openjdk-17-jdk"
JAVA_DEFAULT=17

# ---- Maven -----------------------------------------------------------------
# Installed via apt. Ubuntu 24.04 ships Maven 3.8.x.
# To pin a specific version, set MAVEN_VERSION and install via archive below.
MAVEN_VERSION="3.9.6"
MAVEN_ARCHIVE_URL="https://archive.apache.org/dist/maven/maven-3/${MAVEN_VERSION}/binaries/apache-maven-${MAVEN_VERSION}-bin.tar.gz"

# ---- Tomcat (CRITICAL: only Tomcat 9 — kv-backend compatibility) ----------
TOMCAT_MAJOR=9
TOMCAT_VERSION="9.0.98"
TOMCAT_ARCHIVE_URL="https://archive.apache.org/dist/tomcat/tomcat-${TOMCAT_MAJOR}/v${TOMCAT_VERSION}/bin/apache-tomcat-${TOMCAT_VERSION}.tar.gz"
TOMCAT_INSTALL_DIR="/opt/tomcat9"
TOMCAT_USER="tomcat"

# ---- Node.js ---------------------------------------------------------------
NVM_VERSION="0.40.3"
NODE_VERSIONS="18 20 22"
NODE_DEFAULT=20

# ---- Python ----------------------------------------------------------------
PYTHON_VERSION="3.12.3"

# ---- Terraform -------------------------------------------------------------
# Installed via HashiCorp apt repository (always latest stable).
# No version pin needed — HashiCorp apt repo manages stability.
TERRAFORM_CHANNEL="stable"

# ---- kubectl ---------------------------------------------------------------
# Pinned to a minor version channel. Patch updates come automatically via apt.
KUBECTL_CHANNEL="v1.30"

# ---- Vagrant ---------------------------------------------------------------
# Minimum version required. provision.sh auto-upgrades if below this.
VAGRANT_MIN_VERSION="2.4.0"
VAGRANT_INSTALL_VERSION="2.4.3"

# ---- Vagrant VMware Utility ------------------------------------------------
VMWARE_UTILITY_VERSION="1.0.22"

# ---- AWS CLI ---------------------------------------------------------------
# Installed directly from AWS (no version pin; always downloads the latest v2).
# Override by setting AWS_CLI_VERSION if a specific release is needed.
AWS_CLI_VERSION="latest"

# ---- Helm ------------------------------------------------------------------
# Installed via the official get-helm-3 script (latest stable).
HELM_INSTALL_SCRIPT="https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3"
