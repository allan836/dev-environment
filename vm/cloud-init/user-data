#cloud-config
# =============================================================================
# cloud-init user-data — Developer Environment VM
#
# PURPOSE:
#   Runs once on the very first boot of the Ubuntu 24.04 cloud image.
#   Works identically across Multipass, libvirt+cloud-init, and Incus.
#
#   Handles everything that must be in place BEFORE Ansible runs:
#     - System locale and timezone
#     - Developer user account (with passwordless sudo)
#     - SSH authorised key for both ubuntu and developer users
#       (SSH_AUTHORIZED_KEY is replaced by provision.sh at launch time)
#     - Base packages needed to pull and run Ansible
#     - Hostname
#
#   All developer tool installation (Docker, Java, Node, Terraform, etc.)
#   is intentionally left to Ansible so it can be re-run idempotently.
#
# TEMPLATING:
#   provision.sh (or each provider's boot function) replaces the literal
#   string  SSH_AUTHORIZED_KEY  with the actual public key before the VM
#   boots.  Do not change this placeholder string.
# =============================================================================

# ---- Locale & timezone -----------------------------------------------------
locale:   en_US.UTF-8
timezone: Africa/Johannesburg

# ---- Hostname ---------------------------------------------------------------
hostname:         dev-env
fqdn:             dev-env.local
manage_etc_hosts: true

# ---- Users ------------------------------------------------------------------
# We preserve the default 'ubuntu' user (used for SSH by all three providers)
# and add a 'developer' user for the actual development workflow.
users:
  - name: ubuntu
    groups: [sudo, docker]
    shell: /bin/bash
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    ssh_authorized_keys:
      - "SSH_AUTHORIZED_KEY"

  - name: developer
    gecos: Developer
    groups: [sudo, docker]
    shell: /bin/bash
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    lock_passwd: false
    ssh_authorized_keys:
      - "SSH_AUTHORIZED_KEY"

# ---- Base packages (minimal: only what Ansible itself needs) ---------------
packages:
  - git
  - curl
  - wget
  - python3
  - python3-pip
  - python3-venv
  - ca-certificates
  - gnupg
  - lsb-release
  - apt-transport-https
  - software-properties-common
  - unzip
  - zip
  - jq
  - htop
  - vim
  - bash-completion
  - net-tools
  - rsync

package_update:  true
package_upgrade: true

# ---- Filesystem resize (cloud images boot small; grow to allocated disk) ----
growpart:
  mode:    auto
  devices: ["/"]
resize_rootfs: true

# ---- First-boot commands ----------------------------------------------------
runcmd:
  # Developer user home ownership
  - [bash, -c, "id developer &>/dev/null && chown -R developer:developer /home/developer || true"]
  # Passwordless sudo (belt-and-suspenders)
  - [bash, -c, "echo 'developer ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/developer && chmod 0440 /etc/sudoers.d/developer"]
  # Workspace directory structure
  - [bash, -c, "sudo -u ubuntu  mkdir -p /home/ubuntu/workspace/repos"]
  - [bash, -c, "sudo -u developer mkdir -p /home/developer/workspace/repos 2>/dev/null || true"]
  # Disable cloud-init on subsequent boots
  - [touch, /etc/cloud/cloud-init.disabled]
  # Signal completion
  - [bash, -c, "echo 'cloud-init: first boot complete' > /tmp/cloud-init-done"]

# ---- Final message ----------------------------------------------------------
final_message: |
  ============================================================
   Dev environment VM is ready (cloud-init complete).
   Ansible provisioning is next — it installs all dev tools.
  ============================================================
