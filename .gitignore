# Secrets & credentials — never commit
*.env
.env.*
!.env.example
*.pem
*.key
*_rsa
*_ed25519
*.crt
secrets/
vault_pass*
*.tfvars
!*.tfvars.example

# Ansible
*.retry
ansible/inventory/*.local.*

# Terraform / OpenTofu state
**/.terraform/
*.tfstate
*.tfstate.*

# Docker
docker/**/data/
docker/**/volumes/

# Large binary assets (e.g. kv-backend preload images tarball) — too big
# for a normal git remote (GitHub rejects >100MB without Git LFS).
# Distribute out-of-band; workstation-bootstrap/scripts/kv-backend.sh
# expects it to exist locally at this path but does not require it in git.
assets/*.tar.gz

# OS / editor cruft
.DS_Store
*.swp
.idea/
.vscode/
*.log

# Python
__pycache__/
*.pyc
.venv/

# Node
node_modules/
